# Copy to zeroclaw.env (gitignored), fill in, `chmod 600 zeroclaw.env`.
# One ZEROCLAW_<dotted__path>=<value> per line; the path must exist in the
# config schema or the daemon refuses to start. Aliases must match config.toml.

# [providers.models.openai.llm] api_key
ZEROCLAW_providers__models__openai__llm__api_key=REPLACE_ME

# [channels.telegram.default] bot_token. Use a token no other instance polls.
ZEROCLAW_channels__telegram__default__bot_token=REPLACE_ME
